{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:schema:agent-tool-eval-direct-driver-request:v0.1",
  "title": "Direct-host driver request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "executionMode", "runId", "task", "purpose", "repeat",
    "target", "providerRef", "driverRef", "budget", "isolation"
  ],
  "properties": {
    "schemaVersion": { "const": "openadam.agent-tool-eval.direct-driver-request.v0.1" },
    "executionMode": { "const": "direct-host" },
    "runId": { "type": "string", "pattern": "^[a-zA-Z0-9._:-]+$", "maxLength": 300 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "invocation", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operationId", "input"],
          "properties": {
            "operationId": { "type": "string", "minLength": 1, "maxLength": 160 },
            "input": {}
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "purpose": { "enum": ["development-smoke", "direct-host-measurement"] },
    "repeat": { "type": "integer", "minimum": 1, "maximum": 20 },
    "target": { "$ref": "#/$defs/ref" },
    "targetCapability": { "$ref": "#/$defs/semanticRef" },
    "targetProcedure": { "$ref": "#/$defs/semanticRef" },
    "providerRef": { "$ref": "#/$defs/ref" },
    "driverRef": { "$ref": "#/$defs/semanticRef" },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 250, "maximum": 600000 },
        "maxCostUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "deniedReadRoots"],
      "properties": {
        "mode": { "const": "deny-read-roots" },
        "deniedReadRoots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/", "maxLength": 1000 }
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "semanticRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    }
  },
  "not": {
    "properties": { "targetCapability": {}, "targetProcedure": {} },
    "required": ["targetCapability", "targetProcedure"]
  }
}
