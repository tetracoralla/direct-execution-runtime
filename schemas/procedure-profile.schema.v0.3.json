{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:schema:procedure-profile:v0.3",
  "title": "OpenAdam Procedure Profile v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "title", "summary", "lifecycle",
    "semantics", "inputSchema", "outputSchema", "stages", "completion", "errors"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "openadam.procedure-profile.v0.3" },
    "id": { "$ref": "#/$defs/stableId" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "lifecycle": { "enum": ["experimental", "stable", "deprecated"] },
    "semantics": { "$ref": "#/$defs/semantics" },
    "inputSchema": { "type": "object" },
    "outputSchema": { "type": "object" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/capabilityStage" }
    },
    "completion": { "$ref": "#/$defs/completion" },
    "errors": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/error" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultVariability", "contextSources", "stateAccess", "idempotency"],
      "properties": {
        "resultVariability": { "enum": ["deterministic", "stochastic"] },
        "contextSources": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": { "enum": ["referenced-resource", "runtime", "ambient"] }
        },
        "stateAccess": { "enum": ["none", "read", "write", "destructive"] },
        "idempotency": { "enum": ["idempotent", "non-idempotent", "unverified"] }
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "operationId"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "version": { "$ref": "#/$defs/semver" },
        "operationId": { "$ref": "#/$defs/stableId" }
      }
    },
    "capabilityStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "title", "purpose", "required", "dependsOn", "capability"],
      "properties": {
        "kind": { "const": "capability" },
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" },
        "condition": { "type": "string", "minLength": 1, "maxLength": 500 },
        "dependsOn": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "capability": { "$ref": "#/$defs/capabilityRequirement" }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": false } }, "required": ["required"] },
          "then": { "required": ["condition"] }
        }
      ]
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "outputStage"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "outputStage": { "$ref": "#/$defs/stableId" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
