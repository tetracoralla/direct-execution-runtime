{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:direct-work-order:v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "calls"],
  "properties": {
    "schemaVersion": { "const": "openadam.direct-work-order.v0.1" },
    "id": { "$ref": "#/$defs/id" },
    "calls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/call" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "capabilityTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capabilityId", "capabilityVersion", "operationId"],
      "properties": {
        "kind": { "const": "capability" },
        "capabilityId": { "$ref": "#/$defs/id" },
        "capabilityVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "operationId": { "$ref": "#/$defs/id" }
      }
    },
    "mcpTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "toolName"],
      "properties": {
        "kind": { "const": "mcp-tool" },
        "toolName": { "$ref": "#/$defs/id" }
      }
    },
    "mcpOperationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "toolName", "operationId"],
      "properties": {
        "kind": { "const": "mcp-operation" },
        "toolName": { "$ref": "#/$defs/id" },
        "operationId": { "$ref": "#/$defs/id" }
      }
    },
    "procedureTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "procedureId", "procedureVersion"],
      "properties": {
        "kind": { "const": "procedure" },
        "procedureId": { "$ref": "#/$defs/id" },
        "procedureVersion": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "providerId", "target", "input"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "providerId": { "$ref": "#/$defs/id" },
        "target": {
          "oneOf": [
            { "$ref": "#/$defs/capabilityTarget" },
            { "$ref": "#/$defs/procedureTarget" },
            { "$ref": "#/$defs/mcpTarget" },
            { "$ref": "#/$defs/mcpOperationTarget" }
          ]
        },
        "input": { "type": "object" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 }
      }
    }
  }
}
