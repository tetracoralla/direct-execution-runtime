{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:direct-provider-config:v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providers"],
  "properties": {
    "schemaVersion": { "const": "openadam.direct-provider-config.v0.2" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxConcurrentCalls": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxQueuedCalls": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "maxWorkOrderCalls": { "type": "integer", "minimum": 1, "maximum": 128 },
        "maxWorkOrderBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
        "maxProviderResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
        "maxResultBytes": { "type": "integer", "minimum": 262144, "maximum": 33554432 },
        "maxProtocolLineBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
        "maxStderrBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "defaultTimeoutMs": { "type": "integer", "minimum": 10, "maximum": 300000 },
        "circuitBreakerFailureThreshold": { "type": "integer", "minimum": 1, "maximum": 100 },
        "circuitBreakerCooldownMs": { "type": "integer", "minimum": 10, "maximum": 300000 }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/capabilityJsonlProvider" },
          { "$ref": "#/$defs/procedureJsonlProvider" },
          { "$ref": "#/$defs/mcpProvider" }
        ]
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096
    },
    "lifecycle": {
      "type": "string",
      "enum": ["persistent", "per-call"]
    },
    "identityFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/absolutePath" }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "inputSchemaPath", "outputSchemaPath"],
      "properties": {
        "operationId": { "$ref": "#/$defs/identity" },
        "inputSchemaPath": { "$ref": "#/$defs/absolutePath" },
        "outputSchemaPath": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "capabilityJsonlProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId", "transport", "lifecycle", "rootPath", "profilePath", "manifestPath", "identityFiles",
        "capabilityId", "capabilityVersion", "contracts"
      ],
      "properties": {
        "providerId": { "$ref": "#/$defs/identity" },
        "transport": { "const": "capability-jsonl-v0.1" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "rootPath": { "$ref": "#/$defs/absolutePath" },
        "profilePath": { "$ref": "#/$defs/absolutePath" },
        "manifestPath": { "$ref": "#/$defs/absolutePath" },
        "identityFiles": { "$ref": "#/$defs/identityFiles" },
        "capabilityId": { "$ref": "#/$defs/identity" },
        "capabilityVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/contract" }
        }
      }
    },
    "procedureJsonlProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId", "transport", "lifecycle", "rootPath", "profilePath",
        "implementationManifestPath", "identityFiles", "procedureId", "procedureVersion",
        "inputSchemaPath", "outputSchemaPath"
      ],
      "properties": {
        "providerId": { "$ref": "#/$defs/identity" },
        "transport": { "const": "procedure-jsonl-v0.2" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "rootPath": { "$ref": "#/$defs/absolutePath" },
        "profilePath": { "$ref": "#/$defs/absolutePath" },
        "implementationManifestPath": { "$ref": "#/$defs/absolutePath" },
        "identityFiles": { "$ref": "#/$defs/identityFiles" },
        "procedureId": { "$ref": "#/$defs/identity" },
        "procedureVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "inputSchemaPath": { "$ref": "#/$defs/absolutePath" },
        "outputSchemaPath": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "mcpProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId", "transport", "lifecycle", "rootPath", "command", "args",
        "cwd", "identityFiles", "expectedServer", "allowedTools"
      ],
      "properties": {
        "providerId": { "$ref": "#/$defs/identity" },
        "transport": { "const": "mcp-stdio" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "rootPath": { "$ref": "#/$defs/absolutePath" },
        "command": { "$ref": "#/$defs/absolutePath" },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "cwd": { "$ref": "#/$defs/absolutePath" },
        "identityFiles": { "$ref": "#/$defs/identityFiles" },
        "expectedServer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "version": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        },
        "allowedTools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identity" }
        },
        "operationProjections": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/operationProjection" }
        }
      }
    },
    "operationProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolName", "operationField", "argumentsField"],
      "properties": {
        "toolName": { "$ref": "#/$defs/identity" },
        "operationField": { "$ref": "#/$defs/identity" },
        "argumentsField": { "$ref": "#/$defs/identity" },
        "batchToolName": { "$ref": "#/$defs/identity" },
        "batchItemsField": { "$ref": "#/$defs/identity" },
        "schemaLookup": { "$ref": "#/$defs/schemaLookup" }
      },
      "dependentRequired": {
        "batchToolName": ["batchItemsField"],
        "batchItemsField": ["batchToolName"]
      }
    },
    "schemaLookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolName", "operationField", "resultPath"],
      "properties": {
        "toolName": { "$ref": "#/$defs/identity" },
        "operationField": { "$ref": "#/$defs/identity" },
        "resultPath": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/identity" }
        }
      }
    }
  }
}
