{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:schema:provider-manifest:v0.2",
  "title": "OpenAdam capability provider manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "implementations"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "openadam.provider-manifest.v0.2" },
    "provider": { "$ref": "#/$defs/provider" },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/implementation" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "$ref": "#/$defs/semver" },
        "homepage": { "type": "string", "format": "uri" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "command", "args"],
      "properties": {
        "protocol": { "const": "openadam.capability-jsonl.v0.1" },
        "command": { "type": "string", "minLength": 1, "maxLength": 200 },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 500 }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "adapterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "target"],
      "properties": {
        "operationId": { "$ref": "#/$defs/stableId" },
        "target": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "transportSchemaProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "command", "args"],
      "properties": {
        "protocol": { "const": "openadam.transport-schema-jsonl.v0.1" },
        "command": { "type": "string", "minLength": 1, "maxLength": 200 },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 500 }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "schemaDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "output": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "transportSchemaDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": {
        "input": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "output": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "transport",
        "target",
        "contractSchemaDigests",
        "transportSchemaDigests"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/stableId" },
        "transport": { "enum": ["mcp-tool", "cli", "library", "http"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 200 },
        "contractSchemaDigests": { "$ref": "#/$defs/schemaDigests" },
        "transportSchemaDigests": { "$ref": "#/$defs/transportSchemaDigests" },
        "annotations": { "type": "object" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "capabilityVersion",
        "adapter",
        "adapterBindings",
        "transportSchemaProbe",
        "bindings"
      ],
      "properties": {
        "capabilityId": { "$ref": "#/$defs/stableId" },
        "capabilityVersion": { "$ref": "#/$defs/semver" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "adapterBindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/adapterBinding" }
        },
        "transportSchemaProbe": { "$ref": "#/$defs/transportSchemaProbe" },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/binding" }
        }
      }
    }
  }
}
