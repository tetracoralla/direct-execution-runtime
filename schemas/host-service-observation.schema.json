{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:direct-host-service-observation:v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "socketPath", "pid", "limits"],
  "properties": {
    "schemaVersion": { "const": "openadam.direct-host-service-observation.v0.1" },
    "status": { "const": "ready" },
    "socketPath": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "pid": { "type": "integer", "minimum": 1 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConnections", "requestReceiveTimeoutMs", "maxWorkOrderBytes", "maxResultBytes"],
      "properties": {
        "maxConnections": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "requestReceiveTimeoutMs": { "type": "integer", "minimum": 10, "maximum": 60000 },
        "maxWorkOrderBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
        "maxResultBytes": { "type": "integer", "minimum": 262144, "maximum": 33554432 }
      }
    }
  }
}
