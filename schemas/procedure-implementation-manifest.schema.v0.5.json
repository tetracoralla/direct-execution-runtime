{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:schema:procedure-implementation-manifest:v0.5",
  "title": "OpenAdam Procedure implementation manifest v0.5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "implementations"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "openadam.procedure-implementation-manifest.v0.5" },
    "provider": { "$ref": "#/$defs/provider" },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/implementation" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "$ref": "#/$defs/semver" },
        "homepage": { "type": "string", "format": "uri" }
      }
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "schemaDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "$ref": "#/$defs/digest" },
        "output": { "$ref": "#/$defs/digest" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "command", "args"],
      "properties": {
        "protocol": { "const": "openadam.procedure-jsonl.v0.2" },
        "command": { "type": "string", "minLength": 1, "maxLength": 200 },
        "args": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 500 }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "enum": ["cli", "library", "open-workflow", "mcp-tool", "native-function", "http"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "stageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageId", "capabilityId", "capabilityVersion", "operationId",
        "provider", "transport", "target"
      ],
      "properties": {
        "stageId": { "$ref": "#/$defs/stableId" },
        "capabilityId": { "$ref": "#/$defs/stableId" },
        "capabilityVersion": { "$ref": "#/$defs/semver" },
        "operationId": { "$ref": "#/$defs/stableId" },
        "provider": { "$ref": "#/$defs/provider" },
        "transport": { "enum": ["capability-jsonl", "mcp-tool", "cli", "library", "http", "native-function"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "procedureId", "procedureVersion", "profileDigest", "adapter", "binding",
        "contractSchemaDigests", "stages"
      ],
      "properties": {
        "procedureId": { "$ref": "#/$defs/stableId" },
        "procedureVersion": { "$ref": "#/$defs/semver" },
        "profileDigest": { "$ref": "#/$defs/digest" },
        "adapter": { "$ref": "#/$defs/adapter" },
        "binding": { "$ref": "#/$defs/binding" },
        "contractSchemaDigests": { "$ref": "#/$defs/schemaDigests" },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/stageBinding" }
        }
      }
    }
  }
}
