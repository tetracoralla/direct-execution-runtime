{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:schema:capability-profile:v0.3",
  "title": "OpenAdam Capability Profile v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "summary",
    "lifecycle",
    "operations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "openadam.capability-profile.v0.3" },
    "id": { "$ref": "#/$defs/stableId" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "lifecycle": { "enum": ["experimental", "stable", "deprecated"] },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "jsonSchema": {
      "type": "object",
      "minProperties": 1
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultVariability",
        "contextSources",
        "stateAccess",
        "idempotency",
        "openWorld",
        "ambiguity",
        "provenance"
      ],
      "properties": {
        "resultVariability": { "enum": ["deterministic", "stochastic"] },
        "contextSources": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": { "enum": ["referenced-resource", "runtime", "ambient"] }
        },
        "stateAccess": { "enum": ["none", "read", "write", "destructive"] },
        "idempotency": { "enum": ["idempotent", "non-idempotent", "unverified"] },
        "openWorld": { "type": "boolean" },
        "ambiguity": {
          "enum": ["reject", "return-candidates", "context-required", "not-applicable"]
        },
        "provenance": { "enum": ["required", "optional", "not-applicable"] }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "description", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 100
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "type": "boolean" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "semantics",
        "inputSchema",
        "outputSchema",
        "errors"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "semantics": { "$ref": "#/$defs/semantics" },
        "inputSchema": { "$ref": "#/$defs/jsonSchema" },
        "outputSchema": { "$ref": "#/$defs/jsonSchema" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        }
      }
    }
  }
}
