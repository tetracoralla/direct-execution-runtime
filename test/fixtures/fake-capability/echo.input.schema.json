{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["value"],
  "properties": {
    "value": { "type": "string", "maxLength": 2000000 },
    "behavior": {
      "type": "string",
      "enum": ["echo", "provider-error", "crash", "malformed", "stderr", "large"]
    },
    "delayMs": { "type": "integer", "minimum": 0, "maximum": 5000 }
  }
}
